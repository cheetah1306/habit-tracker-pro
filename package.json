{
  "name": "habit-tracker-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "powershell.exe -ExecutionPolicy Bypass -File scripts\\ensure-dev-cert.ps1",
    "dev": "vite",
    "prepreview": "powershell.exe -ExecutionPolicy Bypass -File scripts\\ensure-dev-cert.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:build:release": "powershell.exe -ExecutionPolicy Bypass -Command \"$env:JAVA_HOME = \\\"$PWD\\.jdk17\\jdk-17.0.19+10\\\"; $env:PATH = \\\"$PWD\\.jdk17\\jdk-17.0.19+10\\bin;\\\" + $env:PATH; cd android; .\\gradlew.bat bundleRelease\"",
    "android:apk": "npm run cap:sync && powershell.exe -ExecutionPolicy Bypass -File build_apk.ps1",
    "android:dev": "npx cap run android -l --host localhost --port 5173 --forwardPorts 5173:5173"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.7"
  }
}
